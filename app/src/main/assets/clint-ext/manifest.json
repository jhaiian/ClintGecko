{
  "manifest_version": 2,
  "name": "Clint Engine Bridge",
  "version": "1.2",
  "description": "Connects Clint Gecko to the Gecko engine",
  "browser_specific_settings": {
    "gecko": {
      "id": "clint@jhaiian.com"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "browsingData",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "experiment_apis": {
    "clintAddons": {
      "schema": "experiments/addons/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/addons/parent.js",
        "paths": [
          [
            "clintAddons"
          ]
        ]
      }
    }
  }
}
